{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-injector.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking which skills this prompt needs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-gate.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the skills this file needs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/clone-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the branch for duplicated code"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/node_modules/.bin/probity --agent claude-code",
            "timeout": 120,
            "statusMessage": "Probity: checking TDD"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-output-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the test output stays whole"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting frontend changes"
          }
        ]
      }
    ]
  }
}
